# 本地一键入库脚本配置（local_ingest.py 用）。仅本机使用，切勿提交！
# 复制本文件为 .env 后填入你的值。

# 1) DeepSeek API 密钥（用于 AI 结构化摘要/大纲/标签）
DEEPSEEK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 2) zsks 内部接口鉴权令牌（GitHub 仓库 Settings → Secrets and variables → Actions 里的 INGEST_TOKEN 的值）
INGEST_TOKEN=你的_ingest_token值

# 3) 可选：zsks Worker 地址（默认即可）
# WORKER_URL=https://zsks.pages.dev

# 4) 可选：whisper 模型（本机弱可改 tiny/base，强可 small/medium）
# WHISPER_MODEL=small
